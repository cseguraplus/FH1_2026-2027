  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fh-auth",
        "description": "Cookie propuesta compatible con la actual. No es una clave que el usuario deba copiar."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "founder": {
            "type": "boolean"
          },
          "referral_code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "city",
          "founder",
          "referral_code"
        ]
      },
      "Course": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "progress_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "title",
          "route",
          "version",
          "progress_percent"
        ]
      },
      "NetworkMember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "founder": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "display_name",
          "depth",
          "founder"
        ]
      },
      "Playback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playback_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "playback_url",
          "expires_at"
        ]
      },
      "ProgressInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "lesson_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "position_seconds": {
            "type": "number",
            "minimum": 0
          },
          "interval_start": {
            "type": "number",
            "minimum": 0
          },
          "interval_end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "event_id",
          "lesson_version_id",
          "position_seconds",
          "interval_start",
          "interval_end"
        ]
      },
      "ProgressResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "position_seconds": {
            "type": "number",
            "minimum": 0
          },
          "coverage_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "completed": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted",
          "position_seconds",
          "coverage_percent",
          "completed"
        ]
      },
      "OrderInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "product_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "product_id",
                "quantity"
              ]
            }
          },
          "shipping_address_id": {
            "type": "string",
            "format": "uuid"
          },
          "terms_version": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "shipping_address_id",
          "terms_version"
        ]
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_payment",
              "paid",
              "cancelled",
              "partially_refunded",
              "refunded"
            ]
          },
          "total_cents": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "MXN"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "total_cents",
          "currency",
          "created_at"
        ]
      },
      "ClosePreviewInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_input_hash": {
            "type": "string"
          }
        },
        "required": [
          "rule_version_id",
          "expected_input_hash"
        ]
      },
      "ClosePreview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preview_id": {
            "type": "string",
            "format": "uuid"
          },
          "input_hash": {
